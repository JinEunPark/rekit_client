pipeline {
    agent any

    parameters {
        string(
            name: 'RELEASE_TAG',
            defaultValue: '',
            description: '빌드할 git 태그 (X.Y.Z). 먼저 `git push origin <tag>` 로 올려둔 태그여야 한다.'
        )
    }

    environment {
        REGISTRY   = '127.0.0.1:5000'
        IMAGE_NAME = 'rekit-client'
        // 저장소에 커밋하지 않는 빌드타임 주입값(OAuth client id 등) — 백엔드(rekit_backend.env)와 동일 규칙.
        // jenkins 컨테이너에 /home/wlsdms/rekit/secrets 가 :ro 로 마운트돼 있음.
        CLIENT_ENV_FILE = '/home/wlsdms/rekit/secrets/rekit_client.env'
    }

    stages {
        stage('Checkout tag') {
            steps {
                script {
                    if (!params.RELEASE_TAG?.trim()) {
                        error 'RELEASE_TAG 를 입력하세요 (예: 0.0.1)'
                    }
                }
                sh 'git fetch --tags --force --prune'
                sh "git checkout tags/${params.RELEASE_TAG}"
                script {
                    // 이미지 태그 = 지금 체크아웃된 커밋에 정확히 달린 git 태그 (없으면 실패)
                    env.IMAGE_TAG = sh(
                        script: 'git describe --tags --exact-match HEAD',
                        returnStdout: true
                    ).trim()
                    if (!env.IMAGE_TAG?.matches(/^\d+\.\d+\.\d+$/)) {
                        error "HEAD 에 X.Y.Z 형식 태그가 없습니다: '${env.IMAGE_TAG}'"
                    }
                }
            }
        }

        stage('Build & Push') {
            steps {
                sh '''
                    set -eu
                    # VITE_* 값을 시크릿 파일에서 로드 (파일 없으면 빈 값으로 빌드 → 소셜 로그인만 비활성)
                    if [ -f "$CLIENT_ENV_FILE" ]; then
                        set -a
                        . "$CLIENT_ENV_FILE"
                        set +a
                    else
                        echo "WARN: $CLIENT_ENV_FILE 없음 — OAuth 값 없이 빌드함"
                    fi

                    docker build \
                      --build-arg VITE_KAKAO_CLIENT_ID="${VITE_KAKAO_CLIENT_ID:-}" \
                      --build-arg VITE_KAKAO_REDIRECT_URI="${VITE_KAKAO_REDIRECT_URI:-}" \
                      --build-arg VITE_NAVER_CLIENT_ID="${VITE_NAVER_CLIENT_ID:-}" \
                      --build-arg VITE_NAVER_REDIRECT_URI="${VITE_NAVER_REDIRECT_URI:-}" \
                      --build-arg VITE_GOOGLE_CLIENT_ID="${VITE_GOOGLE_CLIENT_ID:-}" \
                      --build-arg VITE_GOOGLE_REDIRECT_URI="${VITE_GOOGLE_REDIRECT_URI:-}" \
                      -t "$REGISTRY/$IMAGE_NAME:$IMAGE_TAG" \
                      .
                    docker push "$REGISTRY/$IMAGE_NAME:$IMAGE_TAG"
                '''
            }
        }
    }

    post {
        success {
            echo "이미지 push 완료: ${REGISTRY}/${IMAGE_NAME}:${env.IMAGE_TAG}. 배포는 deploy-client 잡에서 VERSION 드롭다운으로 실행."
        }
    }
}
