pipeline {
    agent any

    parameters {
        // Git Parameter 플러그인 — 배포할 git 태그를 목록에서 고른다.
        gitParameter(
            name: 'VERSION',
            type: 'PT_TAG',
            tagFilter: '*',
            sortMode: 'DESCENDING_SMART',
            selectedValue: 'TOP',
            description: '배포할 git 태그. 그대로 두면 가장 최신 태그. 롤백은 이전 태그를 고른다.'
        )
    }

    environment {
        COMPOSE_PROJECT = 'rekit-client'
    }

    stages {
        stage('Deploy') {
            steps {
                script {
                    if (!params.VERSION?.trim()) {
                        error 'VERSION 이 비었습니다. 먼저 build-client 잡으로 해당 태그 이미지를 빌드했는지 확인하세요.'
                    }
                }
                echo "Deploying 127.0.0.1:5000/rekit-client:${params.VERSION}"
                sh """
                    IMAGE_TAG=${params.VERSION} docker compose -p ${COMPOSE_PROJECT} -f docker-compose.prod.yml pull web
                    IMAGE_TAG=${params.VERSION} docker compose -p ${COMPOSE_PROJECT} -f docker-compose.prod.yml up -d web
                    docker image prune -f
                """
            }
        }
    }
}
